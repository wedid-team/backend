# nginx 이미지가 시작할 때 ${DOMAIN}을 환경변수 값으로 바꿔 /etc/nginx/conf.d/default.conf를 만든다.
# ($host 같은 nginx 변수는 그대로 남는다)

# HTTP: 인증서 발급·갱신 확인용 경로만 열고 나머지는 HTTPS로 보냄
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: Spring 앱으로 전달
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    client_max_body_size 10m;

    location / {
        proxy_pass http://app:8080;

        # Spring(server.forward-headers-strategy=framework)이 원래 https 주소를 알 수 있게 전달
        # → Swagger 서버 주소, OAuth redirect URI가 https://${DOMAIN}으로 만들어짐
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;

        proxy_read_timeout 60s;
    }
}
