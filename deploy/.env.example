# EC2 배포용 환경변수. 이 파일을 복사해 deploy/.env로 만들고 값을 채워주세요.
#   cp deploy/.env.example deploy/.env
# deploy/.env는 git에 커밋되지 않습니다(.gitignore의 .env).
# 값에 따옴표를 붙이지 마세요.

# ── 도메인 / 인증서 ──
# 백엔드 도메인: api.<도메인> (A 레코드 → EC2 탄력적 IP). 프론트는 <도메인>
DOMAIN=
# Let's Encrypt 만료 알림을 받을 이메일
CERT_EMAIL=

# ── DB (Neon) ──
# Neon 대시보드 > Connect 에서 Connection pooling을 끈 주소 기준
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require 를 아래처럼 나눠서 입력
DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=

# ── 인증 ──
# 32바이트 이상 랜덤 값, 로컬과 다른 값 사용 (예: openssl rand -base64 48)
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 프론트엔드 ──
# 로그인 후 돌아갈 프론트 주소 (예: https://<도메인>)
FRONTEND_BASE_URL=
# CORS 허용 origin (쉼표로 여러 개, 예: https://<도메인>,http://localhost:3000)
CORS_ALLOWED_ORIGINS=

# ── 서버 ──
# 앱 컨테이너 메모리 제한 (t4g.small 2GB 기준, JVM 힙은 이 값의 75%). 비우면 768m
APP_MEM_LIMIT=1536m

# AUTH_COOKIE_SECURE는 docker-compose.yml에서 true로 고정합니다.
# WEDID_IMPORT_DIRECTORY는 XLSX 적재 때만 필요해 서버에는 넣지 않습니다.
