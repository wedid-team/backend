# 이 파일을 복사해 .env로 만들고 필요한 값을 채워주세요.
#   cp .env.example .env
# .env는 git에 커밋되지 않습니다(.gitignore 참고).
# 여기 적힌 값은 실제 환경변수가 없을 때만 사용되는 기본값을 설명하는 용도이며,
# docker-compose로 로컬 DB를 띄웠다면 DB_* 값은 비워둬도 동작합니다.

# XLSX 원본 파일이 들어있는 폴더 경로 (필수, 개발자별로 다름)
WEDID_IMPORT_DIRECTORY=

# PostgreSQL 연결 정보
# URL/계정은 docker-compose 기본값과 동일해 보통 비워둬도 되지만,
# 비밀번호는 보안 규칙상 기본값 없이 필수로 받으므로 아래처럼 꼭 채워주세요.
# 로컬에 PostgreSQL을 직접 설치해 5432 포트를 쓰고 있다면 docker-compose의 DB는 5433으로 매핑됩니다.
# DB_URL=jdbc:postgresql://localhost:5433/wedid
# DB_USERNAME=postgres
# 아래 값은 docker-compose.yml에 이미 공개되어 있는 로컬 전용 더미 비밀번호입니다.
# 운영/공용 DB 등 진짜 비밀번호가 필요한 환경에서는 절대 재사용하지 말고 실제 값으로 바꿔주세요.
DB_PASSWORD=postgres

# 프론트엔드 개발 서버 주소 (CORS 허용 origin, 기본값은 http://localhost:3000)
# CORS_ALLOWED_ORIGINS=http://localhost:3000
